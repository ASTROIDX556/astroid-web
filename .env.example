# The base URL of the Astroid API. When unset, astroid-web serves fully-featured
# mock data so every screen renders without a running backend.
NEXT_PUBLIC_API_URL=

# The API version prefix. All endpoints live under this path.
NEXT_PUBLIC_API_VERSION=/api/v1

# Supabase project URL and anon key, used for real-time agent telemetry,
# balance updates, and approval-request subscriptions. When either is unset,
# the app falls back to a simulated mock stream — no real-time features are lost.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
