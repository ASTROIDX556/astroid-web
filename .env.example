# The base URL of the Astroid API. When unset, astroid-web serves fully-featured
# mock data so every screen renders without a running backend.
NEXT_PUBLIC_API_URL=

# The API version prefix. All endpoints live under this path.
NEXT_PUBLIC_API_VERSION=/api/v1

# Supabase project URL and anon key, used for real-time agent telemetry,
# balance updates, and approval-request subscriptions. When either is unset,
# the app falls back to a simulated mock stream — no real-time features are lost.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Mock-provider tuning (only used while NEXT_PUBLIC_API_URL is unset).
# Base simulated network latency per request, in milliseconds. Defaults to 320.
NEXT_PUBLIC_MOCK_LATENCY_MS=320
# Random jitter added on top of the base latency, in milliseconds. Defaults to 80.
NEXT_PUBLIC_MOCK_LATENCY_JITTER_MS=80
# Probability (0–1) that a mock request fails transiently, to exercise TanStack
# Query retry/error states. Defaults to 0 (never fails).
NEXT_PUBLIC_MOCK_FAILURE_RATE=0
